# .gitignore  --  place at the REPO ROOT, next to the "Code" folder.

# ---- Python (no slash -> matches at any depth, covers Code/ too) ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- OS / editors ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Data inside the Code folder: keep ONLY the CSV corpora ----
# ignores the unzipped PoeTree JSON dump (Code/data/poetree_en/) and stray *.json
Code/data/*
!Code/data/.gitkeep
!Code/data/*.csv

# ---- Generated figures ----
Code/outputs/*.png
!Code/outputs/.gitkeep

# ---- Downloaded archives ----
*.zip