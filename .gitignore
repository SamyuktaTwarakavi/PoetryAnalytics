# .gitignore  --  place at the REPO ROOT, next to the "Code" folder.

# ---- Python (no slash -> matches at any depth, covers Code/ too) ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- OS / editors ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Data: keep ONLY the CSV corpora ----
# ignores the PoeTree dump (Code/data/poetree_en/), the downloaded lexicons
# (Code/data/lexicons/), stray *.json, etc.
Code/data/*
!Code/data/.gitkeep
!Code/data/*.csv

# ---- Generated figures (results_*.md and closeread.md stay tracked) ----
Code/outputs/*.png
!Code/outputs/.gitkeep

# ---- Downloaded archives ----
*.zip